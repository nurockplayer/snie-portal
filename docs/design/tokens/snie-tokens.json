    "localeBarHeight": {
      "value": "2.75rem",
      "label": "REQUIRED",
      "note": "Holds 44px targets. The bar scrolls away; it is not sticky."
    },
    "headerHeight": {
      "value": "4rem",
      "label": "REQUIRED",
      "note": "Outer box is 64px at every width and locale, including forced colours (the borders drawn there are subtracted from the inner row), so one token can offset fragment targets (#54)."
    },
    "anchorOffset": {
      "value": "calc(var(--snie-header-height) + 1rem)",
      "label": "REQUIRED",
      "use": "html { scroll-padding-top }"
    },
    "shortViewport": {
      "value": "32rem",
      "label": "HEURISTIC",
      "note": "Below this viewport height the header stops being sticky and --snie-anchor-offset drops to 1rem, so the header, locale bar and open menu don't consume the little height there is (e.g. 1280x800 at 400% zoom is about 320x200 CSS px). The open menu is also bounded to the remaining viewport height and scrolls internally at every height."
    }
  },
