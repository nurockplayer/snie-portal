  "typography": {
    "family": {
      "latin": {
        "css": "--snie-font-latin",
        "value": "var(--font-inter, Inter), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "label": "REFERENCE",
        "note": "Inter matches Tachiko. Production loads it through next/font/google, which downloads it at build time and serves it from the deployment. The var() carries a fallback so a document root that forgets the --font-inter class still gets a sans-serif stack instead of an invalid declaration."
      },
      "ja": {
        "css": "--snie-font-ja",
        "value": "var(--font-inter, Inter), \"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", \"Noto Sans CJK JP\", \"Yu Gothic UI\", \"Yu Gothic\", Meiryo, sans-serif",
        "label": "REQUIRED",
        "note": "Selected by :lang(ja). Japanese glyph forms for unified Han characters."
      },
      "zh-TW": {
        "css": "--snie-font-zh-tw",
        "value": "var(--font-inter, Inter), \"PingFang TC\", \"Noto Sans TC\", \"Noto Sans CJK TC\", \"Microsoft JhengHei UI\", \"Microsoft JhengHei\", sans-serif",
        "label": "REQUIRED",
        "note": "Selected by :lang(zh-TW). Traditional Chinese glyph forms; never falls through a Japanese face first."
      }
    },
