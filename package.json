{
  "name": "snie-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-cloudflare-output.mjs",
    "lint": "eslint",
    "check:mvp": "node scripts/validate-mvp.mjs",
    "test:ops": "node --test scripts/smoke-production.test.mjs scripts/menu-dismissal.test.mjs scripts/skip-to-content.test.mjs scripts/contact-copy.test.mjs scripts/localized-404.test.mjs scripts/social-preview.test.mjs scripts/i18n.test.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "crawl:legacy-media": "node scripts/legacy-media-crawler.mjs",
    "test:media": "node --test scripts/legacy-media-crawler.test.mjs",
    "test:images": "node --test scripts/image-derivatives.test.mjs",
    "reconcile:wayback": "node scripts/wayback-reconcile.mjs",
    "test:archive": "node --test scripts/wayback-reconcile.test.mjs",
    "test:content": "node --test scripts/activity-records.test.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23"
    }
  }
}
